# Binary assets: never let core.autocrlf touch these. Without this,
# git's binary-detection heuristic can misfire on a later checkout/add
# and silently corrupt the file by converting line endings inside
# binary data.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.mov binary
*.webm binary
*.zip binary
*.exe binary
*.ico binary

# Launchers: cmd.exe can misparse LF batch files, and a CRLF shebang breaks
# the .sh launchers, so pin both endings regardless of core.autocrlf.
*.cmd text eol=crlf
*.sh text eol=lf
